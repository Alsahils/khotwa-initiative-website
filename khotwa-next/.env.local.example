# ============================================================
# Khotwa Initiative – environment variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must NEVER be committed.
# ============================================================

# ---------------------------
# Supabase – public (client-safe)
# ---------------------------
# Found in: Supabase dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Found in: Supabase dashboard → Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ---------------------------
# Supabase – secret (server / CI only, never expose in browser)
# ---------------------------
# Found in: Supabase dashboard → Settings → API → service_role / secret key
# Used ONLY by scripts/setup-supabase.mjs to create the storage bucket.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
